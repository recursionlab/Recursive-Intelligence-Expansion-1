import json
import random
from pathlib import Path

# Path to evolving codex
LIBRARY_PATH = Path("Meta-Library.json")

# Load the meta-library
def load_library():
    with open(LIBRARY_PATH, "r") as f:
        return json.load(f)

# Save the meta-library (after feedback updates)
def save_library(library):
    with open(LIBRARY_PATH, "w") as f:
        json.dump(library, f, indent=2)

# Mock LLM/Wolf call
def wolf_generate(seed, mask, ritual, split):
    # In real system: call LLM here with structured prompt
    return {
        "Mythic": f"Archetype generated from {seed}+{mask}+{ritual}+{split}",
        "Physical": f"Analogue physics form of {mask} under {ritual}/{split}",
        "Feedback": {
            "Seed": f"{seed}_{ritual}_{split}_Echo",
            "Mask": f"{mask}_{seed}_Refraction",
            "Ritual": f"{ritual}_{split}_Drift",
            "Split": f"{split}_{mask}_Fold"
        }
    }

# Add feedback entry into a codex if new
def add_feedback_entry(lib, category, feedback_name, description_template):
    if not any(entry["name"] == feedback_name for entry in lib[category]):
        lib[category].append({
            "name": feedback_name,
            "description": description_template.format(feedback_name=feedback_name)
        })
        print(f"[+] Added new {category[:-1]}: {feedback_name}")

# Kernel/Lamb cycle
def run_cycle():
    lib = load_library()

    # Randomly select components
    seed = random.choice(lib["Seeds"])["name"]
    mask = random.choice(lib["Masks"])["name"]
    ritual = random.choice(lib["Rituals"])["name"]
    split = random.choice(lib["Splits"])["name"]

    # Call Wolf
    result = wolf_generate(seed, mask, ritual, split)

    # Print result
    print("=== Cycle Result ===")
    print(json.dumps(result, indent=2))

    # Add feedback expansions into all codices
    fb = result["Feedback"]

    add_feedback_entry(lib, "Seeds", fb["Seed"],
        "Autogenerated feedback seed derived from recursion cycle.")
    add_feedback_entry(lib, "Masks", fb["Mask"],
        "Autogenerated feedback mask refracting domain structure.")
    add_feedback_entry(lib, "Rituals", fb["Ritual"],
        "Autogenerated feedback ritual encoding new dynamics.")
    add_feedback_entry(lib, "Splits", fb["Split"],
        "Autogenerated feedback split defining new topology.")

    # Save updated library
    save_library(lib)

if __name__ == "__main__":
    run_cycle()
```

