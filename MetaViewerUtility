# 1. Python Meta-Viewer (Graphviz Tree)

```python
import json
from graphviz import Digraph

META_HISTORY_FILE = "Meta-History.json"

def load_history():
    with open(META_HISTORY_FILE, "r") as f:
        return json.load(f)

def build_graph(history):
    dot = Digraph(comment="Meta-History Genealogy", format="png")
    dot.attr(rankdir="LR", size="8,5")

    prev_node = None
    for i, entry in enumerate(history):
        node_id = f"run_{i}"
        label = f"Run {i}\n{entry['timestamp']}\nSeeds={entry['added']['seeds']}\nMasks={entry['added']['masks']}\nRituals={entry['added']['rituals']}\nSplits={entry['added']['splits']}"
        dot.node(node_id, label, shape="box", style="rounded,filled", fillcolor="lightblue")

        if prev_node:
            dot.edge(prev_node, node_id)

        prev_node = node_id

    return dot

if __name__ == "__main__":
    history = load_history()
    graph = build_graph(history)
    graph.render("Meta-History-Tree", view=True)
```

➡ Run this:

```bash
python meta_viewer.py
```

It will open a **graphical timeline tree** of every cycle, with each run labeled by Seeds/Masks/Rituals/Splits generated.

