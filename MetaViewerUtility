# 2. Web UI Meta-Viewer (Flask + D3.js)

```python
from flask import Flask, render_template, jsonify
import json

app = Flask(__name__)
META_HISTORY_FILE = "Meta-History.json"

@app.route("/")
def index():
    return render_template("index.html")

@app.route("/history")
def history():
    with open(META_HISTORY_FILE, "r") as f:
        history = json.load(f)
    return jsonify(history)

if __name__ == "__main__":
    app.run(debug=True)
```

**`templates/index.html`:**

```html
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Meta-Viewer</title>
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <style>
    .node circle { fill: steelblue; }
    .node text { font: 14px sans-serif; }
    .link { fill: none; stroke: #ccc; stroke-width: 2px; }
  </style>
</head>
<body>
  <h1>ΞKernel Meta-History Viewer</h1>
  <svg width="960" height="600"></svg>
  <script>
    fetch("/history").then(r => r.json()).then(data => {
      const svg = d3.select("svg"),
            width = +svg.attr("width"),
            height = +svg.attr("height");

      const tree = d3.tree().size([height, width - 200]);
      const stratify = d3.stratify().id((d,i) => i).parentId((d,i) => i>0? i-1 : null);

      const root = stratify(data.map((d,i) => ({
        id: i.toString(),
        parentId: i>0 ? (i-1).toString() : null,
        name: `Run ${i}`,
        seeds: d.added.seeds.join(", "),
        masks: d.added.masks.join(", "),
        rituals: d.added.rituals.join(", "),
        splits: d.added.splits.join(", ")
      })));

      tree(root);

      const g = svg.append("g").attr("transform", "translate(40,0)");

      const link = g.selectAll(".link")
        .data(root.links())
        .enter().append("path")
        .attr("class", "link")
        .attr("d", d3.linkHorizontal()
          .x(d => d.y)
          .y(d => d.x));

      const node = g.selectAll(".node")
        .data(root.descendants())
        .enter().append("g")
        .attr("class", "node")
        .attr("transform", d => `translate(${d.y},${d.x})`);

      node.append("circle").attr("r", 6);

      node.append("title")
        .text(d => `Seeds: ${d.data.seeds}\nMasks: ${d.data.masks}\nRituals: ${d.data.rituals}\nSplits: ${d.data.splits}`);

      node.append("text")
        .attr("dy", 3)
        .attr("x", d => d.children ? -12 : 12)
        .style("text-anchor", d => d.children ? "end" : "start")
        .text(d => d.data.name);
    });
  </script>
</body>
</html>
```

➡ Run it:

```bash
python meta_viewer_web.py
```

