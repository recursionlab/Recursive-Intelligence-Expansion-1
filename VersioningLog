## 📂 ΞKernel.py (with persistence + history logging)

```python
import json
import os
from datetime import datetime
import random

META_LIBRARY_FILE = "Meta-Library.json"
META_HISTORY_FILE = "Meta-History.json"

def load_json(filename):
    if not os.path.exists(filename):
        return {"Seeds": [], "Masks": [], "Rituals": [], "Splits": []}
    with open(filename, "r") as f:
        return json.load(f)

def save_json(filename, data):
    with open(filename, "w") as f:
        json.dump(data, f, indent=2)

def append_history(entry):
    if not os.path.exists(META_HISTORY_FILE):
        history = []
    else:
        with open(META_HISTORY_FILE, "r") as f:
            history = json.load(f)
    history.append(entry)
    save_json(META_HISTORY_FILE, history)

def mock_llm_call(prompt):
    """Placeholder for Wolf. In reality, this calls your LLM backend."""
    return f"Feedback expansion based on: {prompt}"

def run_cycle():
    # Load current codex
    codex = load_json(META_LIBRARY_FILE)

    # Pick random existing entries as prompts
    seed = random.choice(codex.get("Seeds", ["Chaos"]))
    mask = random.choice(codex.get("Masks", ["Particle"]))
    ritual = random.choice(codex.get("Rituals", ["Pulse"]))
    split = random.choice(codex.get("Splits", ["Duality"]))

    # Generate Wolf feedback
    prompt = f"Seed={seed}, Mask={mask}, Ritual={ritual}, Split={split}"
    feedback = mock_llm_call(prompt)

    # Expand all four codices
    new_seed = f"{seed}_expanded"
    new_mask = f"{mask}_expanded"
    new_ritual = f"{ritual}_expanded"
    new_split = f"{split}_expanded"

    codex["Seeds"].append(new_seed)
    codex["Masks"].append(new_mask)
    codex["Rituals"].append(new_ritual)
    codex["Splits"].append(new_split)

    # Save updated codex
    save_json(META_LIBRARY_FILE, codex)

    # Log to history
    entry = {
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "added": {
            "seeds": [new_seed],
            "masks": [new_mask],
            "rituals": [new_ritual],
            "splits": [new_split],
        },
        "feedback": feedback
    }
    append_history(entry)

    print("Cycle complete. Updated codex and logged history.")

if __name__ == "__main__":
    run_cycle()
```

